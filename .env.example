# Environment Variables Template
# Copy these variables to your Railway/Render dashboard (or a local .env file, never committed).
# NE JAMAIS mettre de vraies valeurs dans ce fichier : il est versionné.

# Database Configuration (profil prod)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=stage_management
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Database Configuration (profil local / application.properties)
dbName=stage_management
userName=postgres
password=your-local-db-password

# MinIO Configuration
MINIO_URL=http://your-minio-server:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=stage-management
MINIO_REGION=us-east-1

# JWT Configuration
# Générer un secret : openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Mail Configuration (mot de passe d'application Gmail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# CORS : URL(s) du frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ============================================
# RAILWAY SPECIFIC NOTES:
# ============================================
# 1. Railway provides DATABASE_URL automatically when you add PostgreSQL
# 2. Add other variables in Railway dashboard: Settings > Variables
# 3. Railway auto-detects PORT

# ============================================
# RENDER SPECIFIC NOTES:
# ============================================
# 1. Render provides DATABASE_URL automatically when you add PostgreSQL
# 2. Add other variables in Render dashboard: Environment > Environment Variables
# 3. Render uses PORT=10000 by default
